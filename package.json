{
  "name": "contentful-app-ai-reference-field",
  "version": "0.1.0",
  "description": "Contentful UI app that pairs a richer reference-field editor with an AnswerAI/Flowise chat assistant — the editor lets editors curate references with an MDX-based long-text editor and a custom toolbar, and the chat assistant takes the current field value as context for content drafting and feedback.",
  "keywords": [
    "contentful",
    "contentful-app",
    "reference-field",
    "mdx",
    "ai",
    "answerai",
    "flowise",
    "field-editor"
  ],
  "license": "MIT",
  "author": "Adam Harris",
  "homepage": "https://github.com/spindle79/contentful-app-ai-reference-field",
  "repository": {
    "type": "git",
    "url": "https://github.com/spindle79/contentful-app-ai-reference-field.git"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@contentful/app-sdk": "^4.29.1",
    "@contentful/field-editor-markdown": "^1.6.1",
    "@contentful/field-editor-reference": "^5.30.6",
    "@contentful/default-field-editors": "^1.7.12",
    "@contentful/f36-components": "^4.70.0",
    "@contentful/f36-tokens": "^4.0.5",
    "@contentful/react-apps-toolkit": "^1.2.16",
    "@contentful/rich-text-react-renderer": "^15.22.11",
    "@mdxeditor/editor": "^3.16.0",
    "aai-embed": "^1.3.14",
    "aai-embed-react": "~1.0.8",
    "contentful-management": "^11.35.1",
    "emotion": "^10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "upload": "contentful-app-scripts upload --bundle-dir ./dist",
    "upload-ci": "contentful-app-scripts upload --ci --bundle-dir ./dist  --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN",
    "prepare": "husky"
  },
  "devDependencies": {
    "@contentful/app-scripts": "^1.27.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "happy-dom": "^15.7.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.12",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css,html}": "prettier --write"
  }
}
